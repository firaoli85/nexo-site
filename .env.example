# Nexo Access — server-only email secrets (AWS SES v2). Stage 10S.
#
# Copy to `.env.local` (gitignored via `.env*.local`) and fill in real values. These are read ONLY
# on the server, at call time, by src/lib/mail.ts. NEVER prefix them with NEXT_PUBLIC_ — that would
# ship the secret to the browser. If any is missing, the lead forms fail gracefully ("temporarily
# unavailable"); they never crash and never fake success.
#
# Region is us-east-2 (vendor consolidation under the company AWS account).

AWS_SES_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
